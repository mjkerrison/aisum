{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "aisum",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  // Every request goes to src/worker.js first: since the cutover to the events
  // platform, apply.aisum.org forwards everything there, including paths that
  // still exist as files in ./public. Other hosts fall through to the files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
